{
  "name": "mail-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Central mail-sending gateway with guardrails protecting sender reputation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-docs-assets.mjs",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "dev:api": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "cli": "node dist/cli.js",
    "cli:dev": "npm run build && node dist/cli.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "openapi:export": "npm run build && node dist/openapi.export.js",
    "test:ui": "npm run test -w ui",
    "e2e": "playwright test -c ui/playwright.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.1",
    "rxjs": "^7.8.2",
    "svix": "^2.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@scalar/api-reference": "^1.79.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "oauth2-mock-server": "^9.3.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "~5.9",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "ui"
  ]
}
